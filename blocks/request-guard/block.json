{
  "block": "request-guard",
  "portVersion": "0.1.0",
  "port": "port.ts",
  "appImportsOnly": "index.ts",
  "protected": [
    "port.ts",
    "gates.ts"
  ],
  "pluggsInto": "transport boundary middleware (guard(opts) -> router.use)",
  "grades": [
    {
      "grade": "nursery",
      "adapter": "memory-fixed",
      "capabilities": [
        "rate-limit"
      ]
    },
    {
      "grade": "elementary",
      "adapter": "sliding-shield",
      "capabilities": [
        "rate-limit",
        "sliding-window",
        "shield"
      ]
    },
    {
      "grade": "graduated",
      "adapter": "distributed",
      "capabilities": [
        "rate-limit",
        "sliding-window",
        "shield",
        "distributed",
        "bot-detection"
      ],
      "requires": [
        "ioredis",
        "REDIS_URL"
      ]
    }
  ],
  "gates": [
    {
      "id": "gate:nursery->elementary",
      "trigger": "public",
      "activates": [
        "rate-limit",
        "shield"
      ]
    },
    {
      "id": "gate:elementary->graduated",
      "trigger": "instances>1",
      "activates": [
        "distributed-limit"
      ]
    }
  ],
  "consumers": [
    "public endpoint shield (guard at the transport boundary before handlers)",
    "per-caller quota (key on client identity)"
  ],
  "contract": {
    "assertions": [
      "blocks-are-429-or-413"
    ],
    "forbidden": []
  }
}
