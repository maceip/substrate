{
  "block": "realtime",
  "portVersion": "0.1.0",
  "port": "port.ts",
  "appImportsOnly": "index.ts",
  "protected": [
    "port.ts",
    "gates.ts"
  ],
  "grades": [
    {
      "grade": "nursery",
      "adapter": "emitter",
      "capabilities": [
        "per-topic-order"
      ]
    },
    {
      "grade": "elementary",
      "adapter": "buffered",
      "capabilities": [
        "per-topic-order",
        "replay",
        "bounded-queue"
      ]
    },
    {
      "grade": "graduated",
      "adapter": "graduated",
      "capabilities": [
        "per-topic-order",
        "replay",
        "bounded-queue",
        "cross-instance",
        "last-event-id"
      ],
      "standsInFor": "a real broker (Redis pub/sub, NATS, managed SSE/websocket service) — dependency-free SSE bridge over node:http with Last-Event-ID resume"
    }
  ],
  "gates": [
    {
      "id": "gate:nursery->elementary",
      "trigger": "subscribers>1 || prod",
      "activates": [
        "ordered-delivery",
        "replay-buffer",
        "backpressure"
      ]
    },
    {
      "id": "gate:elementary->graduated",
      "trigger": "instances>1 || eventsPerDay>100000",
      "activates": [
        "cross-instance-fanout",
        "wire-reconnect"
      ]
    }
  ],
  "consumers": [
    "live feed / activity stream (UI subscribes to a topic, renders events as they arrive)",
    "reconnecting client (remembers last seen seq, resumes with fromSeq — reconnection semantics live here)",
    "fanout-on-write (a domain write publishes; caches, indexes and watchers react)",
    "presence indicator (derived from subscribe/unsubscribe + subscriberCount on a topic)"
  ],
  "contract": {
    "assertions": [
      "seq-starts-at-one",
      "stamped-at-publish"
    ],
    "forbidden": []
  }
}
