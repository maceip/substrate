{
  "block": "persistence",
  "portVersion": "0.1.0",
  "port": "port.ts",
  "appImportsOnly": "index.ts",
  "protected": ["port.ts", "gates.ts"],
  "grades": [
    { "grade": "nursery", "adapter": "memory", "capabilities": [] },
    { "grade": "elementary", "adapter": "file", "capabilities": ["atomic-write"] },
    { "grade": "graduated", "adapter": "graduated", "capabilities": ["engine", "pool", "mvcc"], "requires": ["pg", "DATABASE_URL"] }
  ],
  "gates": [
    { "id": "gate:nursery->elementary", "trigger": "writers>1 || prodData", "activates": ["durable-writes", "version-field"] },
    { "id": "gate:elementary->graduated", "trigger": "instances>1 || rows>50000", "activates": ["connection-pool", "migrations-registered", "concurrent-safe"] }
  ],
  "consumers": [
    "repository / data-access object (hide query syntax + engine)",
    "transaction boundary (group writes behind one adapter)",
    "baseline domain table (id/created_at/updated_at/version)"
  ]
}
