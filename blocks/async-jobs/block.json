{
  "block": "async-jobs",
  "portVersion": "0.1.0",
  "port": "port.ts",
  "appImportsOnly": "index.ts",
  "protected": [
    "port.ts",
    "gates.ts"
  ],
  "grades": [
    {
      "grade": "nursery",
      "adapter": "inline",
      "capabilities": [
        "job-status",
        "dead-letter"
      ]
    },
    {
      "grade": "elementary",
      "adapter": "retry",
      "capabilities": [
        "job-status",
        "dead-letter",
        "retries"
      ]
    },
    {
      "grade": "graduated",
      "adapter": "durable",
      "capabilities": [
        "job-status",
        "dead-letter",
        "retries",
        "durable-queue",
        "concurrency"
      ]
    }
  ],
  "gates": [
    {
      "id": "gate:nursery->elementary",
      "trigger": "external || prodJobs",
      "activates": [
        "retries",
        "dead-letter"
      ]
    },
    {
      "id": "gate:elementary->graduated",
      "trigger": "instances>1 || jobsPerDay>10000",
      "activates": [
        "durable-queue",
        "concurrency"
      ]
    }
  ],
  "consumers": [
    "long-running task (domain action returns job id/status)",
    "retry/dead-letter handler (failed work is represented explicitly)"
  ],
  "contract": {
    "assertions": [
      "dead-names-its-failure",
      "terminal-iff-finished"
    ],
    "forbidden": [
      "no-result-unless-succeeded"
    ]
  }
}
